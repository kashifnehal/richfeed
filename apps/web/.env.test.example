# Copy to apps/web/.env.test (git-ignored) for the Playwright E2E suite (`pnpm test:e2e`).
# The suite re-seeds the demo dataset before every run (e2e/global-setup.ts), so
# write-path tests can mutate freely.
#
# Use the seeded demo user that owns the data from `pnpm --filter api seed`.
# Mint/rotate the password with:
#   pnpm --filter api create-demo-user -- --user <supabase-auth-user-uuid> --password '<pick-one>'
E2E_BASE_URL=http://localhost:3000
E2E_USER_ID=00000000-0000-0000-0000-000000000000
E2E_USER_EMAIL=demo-user@example.com
E2E_USER_PASSWORD=change-me

# Throwaway account the sign-up smoke test creates fresh each run (global-setup
# deletes it beforehand). Any address you control; "+tag" on a real inbox is fine.
E2E_SIGNUP_EMAIL=you+e2e-signup@example.com
E2E_SIGNUP_PASSWORD=change-me-too
