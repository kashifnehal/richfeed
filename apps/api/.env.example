# Server
PORT=4000

# The web app's own origin — CORS + every OAuth redirect target build off
# this. Not the same as NEXT_PUBLIC_APP_URL (that one's meant for the
# eventual production domain).
FRONTEND_ORIGIN=http://localhost:3000

# Supabase (server-side — admin access, bypasses RLS; never expose to the browser)
# Supabase dashboard → Project Settings → API
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Upstash Redis (used by the BullMQ post-publish queue/worker)
# Upstash console → your database → "redis://…" connection URI (use the TLS "rediss://" URI)
UPSTASH_REDIS_URL=your_upstash_redis_url

# Direct Postgres connection — ADMIN/ONE-OFF USE ONLY (running migrations,
# introspection with the `pg` client). Runtime code should use
# SUPABASE_URL/SUPABASE_SERVICE_ROLE_KEY above instead.
# Supabase dashboard → Project Settings → Database → Connection string →
# "Session pooler" (NOT the direct db.<ref>.supabase.co host — that one is
# IPv6-only and unreachable from many networks/CI runners).
DATABASE_URL=your_supabase_session_pooler_connection_string

# Crypto — used to encrypt stored platform OAuth tokens (AES-256-GCM)
# generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# X (Twitter) OAuth 2.0 (Authorization Code + PKCE) — developer portal app
# settings, confidential client (has a client secret)
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://localhost:4000/api/oauth/x/callback

# Meta — Facebook Login for Business (Facebook Pages)
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:4000/api/oauth/facebook/callback

# Meta — Instagram API with Instagram Login (its own standalone product,
# separate App ID/OAuth flow from Facebook Login for Business above)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:4000/api/oauth/instagram/callback

# Meta — Threads (its own app/credentials, separate from both of the above)
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_REDIRECT_URI=http://localhost:4000/api/oauth/threads/callback

# LinkedIn OAuth 2.0 (personal-profile posting, self-serve, no review gate)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:4000/api/oauth/linkedin/callback
# LinkedIn versions its REST API monthly (YYYYMM) and expects every request
# to pin one — e.g. 202609. Check
# https://learn.microsoft.com/en-us/linkedin/marketing/community-management/shares/posts-api
# for the currently supported range before picking a value.
LINKEDIN_API_VERSION=

# YouTube (Google OAuth 2.0) — Google Cloud Console credentials. The
# redirect URI below must be an EXACT match (no wildcards) with what's
# registered in the Cloud Console credentials screen for this OAuth client.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:4000/api/oauth/youtube/callback
